{
	"name": "@modrinth/monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "vp config --no-agent && pnpm i18n:coverage",
		"setup": "node scripts/setup-worktree.ts",
		"fixture": "node scripts/dev-runner.ts fixture",
		"status": "node scripts/dev-runner.ts status",
		"down": "node scripts/dev-runner.ts down",
		"stop": "node scripts/dev-runner.ts stop",
		"rs": "node scripts/dev-runner.ts rs",
		"dev": "node scripts/dev-runner.ts dev",
		"check:changed": "node scripts/check-changed.ts",
		"scenarios": "node scripts/scenarios.ts",
		"scenarios:prove": "node scripts/prove-scenario.ts",
		"gen:ts": "node scripts/dev-runner.ts gen-ts",
		"sqlx:prepare": "node scripts/sqlx-prepare.ts",
		"sync:repos": "node scripts/sync-repos.ts",
		"app:build": "vp run --filter @modrinth/app build",
		"build": "node ./node_modules/turbo/bin/turbo run build --continue",
		"check": "vp check",
		"fmt": "vp fmt",
		"fmt:check": "vp fmt --check",
		"lint": "vp lint --deny-warnings",
		"lint:ancillary": "prettier --check .github *.*",
		"test": "vp run -r test",
		"test:unit": "vp test run",
		"typecheck": "vp run -r typecheck",
		"fix": "vp check --fix",
		"fix:ancillary": "prettier --write .github *.*",
		"ci": "vp check && vp run -r test",
		"prepr": "node ./node_modules/turbo/bin/turbo run prepr --continue",
		"prepr:frontend": "node ./node_modules/turbo/bin/turbo run prepr --filter=@modrinth/app-frontend",
		"prepr:frontend:lib": "node ./node_modules/turbo/bin/turbo run prepr --filter=@modrinth/ui --filter=@modrinth/assets --filter=@modrinth/api-client --filter=@modrinth/utils --filter=@modrinth/tooling-config",
		"prepr:frontend:app": "node ./node_modules/turbo/bin/turbo run prepr --filter=@modrinth/app-frontend",
		"storybook": "pnpm i18n:coverage && pnpm --filter @modrinth/ui storybook",
		"build-storybook": "pnpm i18n:coverage && pnpm --filter @modrinth/ui build-storybook",
		"icons:add": "pnpm --filter @modrinth/assets icons:add",
		"scripts": "node scripts/run.mjs",
		"i18n:coverage": "node scripts/run.mjs coverage-i18n --write packages/ui/src/layouts/wrapped/settings/language-settings/language-settings-coverage.generated.ts --quiet"
	},
	"devDependencies": {
		"@clack/prompts": "^1.9.0",
		"@coderabbitai/config": "5.3.0",
		"@crowdin/crowdin-api-client": "^1.60.0",
		"@formatjs/icu-messageformat-parser": "^3.5.23",
		"@modrinth/tooling-config": "workspace:*",
		"@tailwindcss/container-queries": "^0.1.1",
		"@types/node": "^24",
		"@typescript-eslint/typescript-estree": "^8.74.0",
		"@vitest/browser-playwright": "5.1.1",
		"@vue/compiler-dom": "^3.5.46",
		"@vue/compiler-sfc": "^3.5.46",
		"@vue/tsconfig": "^0.9.1",
		"chalk": "^6.0.1",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"playwright": "1.65.1",
		"prettier": "^3.10.1",
		"turbo": "^2.11.13",
		"typescript": "^5.9.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
		"vite-plus": "1.8.0",
		"vitest": "5.1.1",
		"vitest-browser-vue": "3.1.0",
		"vue": "^3.5.46",
		"yaml": "^2.9.1"
	},
	"prettier": "@modrinth/tooling-config/prettier.config.cjs",
	"engines": {
		"node": ">=24.22.3"
	},
	"packageManager": "pnpm@12.11.2"
}
