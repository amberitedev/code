{
	"name": "@modrinth/monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "vp config --no-agent",
		"dev": "node scripts/dev-runner.ts dev",
		"dev:app": "node scripts/dev-runner.ts dev:app",
		"dev:core": "node scripts/dev-runner.ts dev:core",
		"dev:convex": "node scripts/dev-runner.ts dev:convex",
		"dev:check": "node scripts/dev-runner.ts dev --dry-run",
		"core:dev": "pnpm --filter @amberite/core run dev",
		"core:dev:na": "pnpm --filter @amberite/core run dev:noauth",
		"core:dev:noauth": "pnpm --filter @amberite/core run dev:noauth",
		"core:setup": "pnpm --filter @amberite/core run setup",
		"web:dev": "vp run --filter @modrinth/frontend dev",
		"web:build": "vp run --filter @modrinth/frontend build",
		"app:dev": "pnpm dev:app",
		"app:debug": "node scripts/app-debug.mjs",
		"devtool:app": "node scripts/app-debug.mjs app",
		"devtool:core": "node scripts/app-debug.mjs core",
		"devtool": "node scripts/app-debug.mjs",
		"app:check": "node scripts/pre-dev.mjs",
		"app:build": "vp run --filter @modrinth/app build",
		"docs:dev": "vp run --filter @modrinth/docs dev",
		"pages:build": "NITRO_PRESET=cloudflare-pages pnpm --filter frontend run build",
		"realtime:dev": "node apps/realtime/scripts/deploy-development.mjs",
		"realtime:status": "node apps/realtime/scripts/status-development.mjs",
		"build": "node ./node_modules/turbo/bin/turbo run build --continue",
		"check": "vp check",
		"fmt": "vp fmt",
		"fmt:check": "vp fmt --check",
		"lint": "vp lint",
		"lint:ancillary": "prettier --check .github *.*",
		"test": "vp run -r test",
		"test:unit": "vp test run",
		"typecheck": "vp run -r typecheck",
		"fix": "vp check --fix",
		"fix:ancillary": "prettier --write .github *.*",
		"ci": "vp check && vp run -r test",
		"prepr": "node ./node_modules/turbo/bin/turbo run prepr --continue",
		"prepr:frontend": "node ./node_modules/turbo/bin/turbo run prepr --filter=@modrinth/frontend --filter=@modrinth/app-frontend",
		"prepr:frontend:lib": "node ./node_modules/turbo/bin/turbo run prepr --filter=@modrinth/ui --filter=@modrinth/moderation --filter=@modrinth/assets --filter=@modrinth/blog --filter=@modrinth/api-client --filter=@modrinth/utils --filter=@modrinth/tooling-config",
		"prepr:frontend:web": "node ./node_modules/turbo/bin/turbo run prepr --filter=@modrinth/frontend",
		"prepr:frontend:app": "node ./node_modules/turbo/bin/turbo run prepr --filter=@modrinth/app-frontend",
		"storybook": "pnpm --filter @modrinth/ui storybook",
		"build-storybook": "pnpm --filter @modrinth/ui build-storybook",
		"icons:add": "pnpm --filter @modrinth/assets icons:add",
		"changelog:collect": "node scripts/run.mjs collect-changelog",
		"changelog:combine-for-app": "node scripts/run.mjs build-theseus-release-notes",
		"scripts": "node scripts/run.mjs"
	},
	"dependencies": {
		"@auth/core": "0.37.0",
		"@convex-dev/auth": "^0.0.92"
	},
	"devDependencies": {
		"@clack/prompts": "^1.0.0",
		"@crowdin/crowdin-api-client": "^1.55.2",
		"@formatjs/icu-messageformat-parser": "^2.11.4",
		"@modrinth/tooling-config": "workspace:*",
		"@tailwindcss/container-queries": "^0.1.1",
		"@types/node": "^24",
		"@typescript-eslint/typescript-estree": "^8.64.0",
		"@vue/compiler-dom": "^3.5.26",
		"@vue/compiler-sfc": "^3.5.26",
		"@vue/tsconfig": "^0.7.0",
		"chalk": "^5.6.2",
		"convex": "^1.21.0",
		"if-ci": "^3.0.0",
		"keep-a-changelog": "^3.0.2",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"prettier": "^3.3.2",
		"turbo": "^2.5.4",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
		"vite-plus": "0.2.9",
		"vitest": "4.1.10",
		"vue": "^3.5.13",
		"yaml": "^2.8.2"
	},
	"prettier": "@modrinth/tooling-config/prettier.config.cjs",
	"engines": {
		"node": ">=24.15.0"
	},
	"packageManager": "pnpm@10.33.2",
	"pnpm": {
		"patchedDependencies": {
			"readable-stream@2.3.8": "patches/readable-stream@2.3.8.patch"
		},
		"peerDependencyRules": {
			"allowedVersions": {
				"vite": "8",
				"esbuild": "0"
			}
		},
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"@sentry/cli",
			"core-js",
			"esbuild",
			"protobufjs",
			"sharp",
			"unrs-resolver",
			"vue-demi",
			"workerd"
		]
	}
}
