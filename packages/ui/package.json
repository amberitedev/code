{
	"name": "@modrinth/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css",
		"**/*.scss",
		"./src/utils/ace-theme.ts",
		"./src/utils/ace-mode-mcfunction.ts"
	],
	"main": "./index.ts",
	"types": "./index.ts",
	"imports": {
		"#ui/*": "./src/*"
	},
	"exports": {
		".": {
			"types": "./index.ts",
			"default": "./index.ts"
		},
		"./src/*": "./src/*"
	},
	"scripts": {
		"intl:extract": "formatjs extract \"src/**/*.{vue,ts,tsx,js,jsx,mts,cts,mjs,cjs}\" --ignore \"src/**/*.d.ts\" --out-file src/locales/en-US/index.json --preserve-whitespace",
		"intl:prune-local": "pnpm -w scripts i18n-icu-contract prune-local --scope packages/ui",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"typecheck": "vue-tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo"
	},
	"dependencies": {
		"@amberite/contracts": "workspace:*",
		"@codemirror/commands": "^6.3.2",
		"@codemirror/lang-markdown": "^6.2.3",
		"@codemirror/state": "^6.3.2",
		"@codemirror/view": "^6.22.1",
		"@floating-ui/vue": "^2.0.1",
		"@modrinth/api-client": "workspace:*",
		"@modrinth/assets": "workspace:*",
		"@modrinth/utils": "workspace:*",
		"@tanstack/vue-query": "5.101.4",
		"@tresjs/cientos": "^4.3.0",
		"@tresjs/core": "^4.3.4",
		"@types/three": "^0.172.0",
		"@vueuse/core": "^11.1.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-search": "^0.16.0",
		"@xterm/xterm": "^6.0.0",
		"ace-builds": "^1.43.5",
		"apexcharts": "^4.0.0",
		"colord": "^2.9.3",
		"dayjs": "^1.11.10",
		"dompurify": "^3.1.7",
		"es-toolkit": "^1.44.0",
		"fabric": "^7.4.0",
		"flatpickr": "^4.6.13",
		"fuse.js": "^6.6.2",
		"intl-messageformat": "^10.7.7",
		"lru-cache": "^11.2.4",
		"motion-v": "^2.2.1",
		"overlayscrollbars": "^2.15.1",
		"qrcode.vue": "^3.4.1",
		"three": "^0.172.0",
		"vue-i18n": "^10.0.0",
		"vue3-ace-editor": "^2.2.4",
		"vue3-apexcharts": "^1.5.2"
	},
	"devDependencies": {
		"@formatjs/cli": "^6.2.12",
		"@modrinth/tooling-config": "workspace:*",
		"@storybook/addon-a11y": "^10.1.10",
		"@storybook/addon-themes": "^10.1.10",
		"@storybook/vue3-vite": "^10.1.10",
		"@vitejs/plugin-vue": "^5.2.1",
		"storybook": "^10.1.10",
		"tailwindcss": "^3.4.4",
		"typescript": "^5.4.5",
		"vite": "^5.4.6",
		"vite-svg-loader": "^5.1.0",
		"vue": "^3.5.43",
		"vue-component-type-helpers": "^3.1.8",
		"vue-router": "^4.6.0",
		"vue-tsc": "^2.1.6"
	},
	"web-types": "../../web-types.json"
}
