{
	"productName": "Modrinth Proxy Lab",
	"identifier": "com.modrinth.proxy-lab",
	"build": {
		"beforeDevCommand": "corepack pnpm -w i18n:coverage && corepack pnpm --dir ../app-frontend exec vite --config ../../packages/proxy-lab/vite.proxy-lab.config.ts"
	},
	"app": {
		"windows": [
			{
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"fullscreen": false,
				"height": 800,
				"resizable": true,
				"title": "Modrinth Proxy Lab",
				"label": "main",
				"width": 1280,
				"minHeight": 700,
				"minWidth": 1100,
				"visible": false,
				"zoomHotkeysEnabled": false,
				"decorations": false
			}
		]
	}
}
