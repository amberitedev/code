{
	"name": "@modrinth/api-client",
	"version": "0.0.0",
	"description": "An API client for Modrinth's API for use in nuxt, tauri and plain node/browser environments.",
	"homepage": "https://github.com/modrinth/code/tree/main/packages/api-client#readme",
	"bugs": {
		"url": "https://github.com/modrinth/code/issues"
	},
	"license": "LGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/modrinth/code.git",
		"directory": "packages/api-client"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "pnpm run clean && node esbuild.config.mjs",
		"lint": "eslint . && prettier --check .",
		"fix": "eslint . --fix && prettier --write .",
		"typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo"
	},
	"dependencies": {
		"@amberite/contracts": "workspace:*",
		"mitt": "^3.0.1",
		"ofetch": "^1.5.1"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "^7.60.2",
		"@modrinth/tooling-config": "workspace:*",
		"@tauri-apps/plugin-http": "~2.5.7",
		"esbuild": "0.28.2",
		"typescript": "^5.9.3",
		"unplugin-dts": "^1.1.2"
	},
	"peerDependencies": {
		"@tauri-apps/plugin-http": "^2.0.0"
	},
	"peerDependenciesMeta": {
		"@tauri-apps/plugin-http": {
			"optional": true
		}
	}
}
