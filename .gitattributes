* text=auto eol=lf

# Excludes locale files that have been automatically trimmed during prepr
# from the diff viewer + diff calculation on GitHub.
**/locales/*/index.json linguist-generated=true
**/locales/en-US/index.json -linguist-generated
packages/contracts/ts/*.ts linguist-generated=true
packages/contracts/ts/index.ts -linguist-generated
# Server profiles that apps/server-meta writes.
meta/** linguist-generated=true -diff
