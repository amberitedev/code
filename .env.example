# Copy this file to .env.local and fill in the real values before running the app.

# Convex deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Convex HTTP and site URLs
CONVEX_URL=
CONVEX_SITE_URL=

# Convex HTTP URL used by the desktop app for relay transport.
# vite.config.ts maps CONVEX_URL to VITE_CONVEX_URL automatically.
VITE_CONVEX_URL=

# Required by the desktop app for payments.
VITE_STRIPE_PUBLISHABLE_KEY=
