# Amberite Core — environment variables
# Copy this file to .env and fill in the values.

# ── Dev mode ─────────────────────────────────────────────────────────────────
# Bypass JWT auth entirely. All endpoints become accessible without an
# Authorization header; AuthUser returns synthetic Claims { sub: "dev-owner" }.
#
# Defaults to true for debug builds (cargo run), false for release builds.
# Only set this explicitly if you need to override the default.
# NEVER set to true in production.
#
# AMBERITE_DEV=true

# ── Storage ───────────────────────────────────────────────────────────────────
# Root directory for all instance data (default: ~/.amberite).
# AMBERITE_DATA_DIR=~/.amberite

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Port the Core API listens on (default: 16662).
# PORT=16662

# Host/IP the Core API binds to (default: 127.0.0.1).
# Set to 0.0.0.0 only when exposing Core to LAN or the public internet.
# AMBERITE_BIND_HOST=127.0.0.1

# Allowed CORS origin (default: https://amberite.dev).
# ALLOWED_ORIGIN=https://amberite.dev

# Public URL clients should use to reach this Core when registering a remote
# pairing code with Convex. Set this for VPS/LAN deployments.
# AMBERITE_PUBLIC_URL=https://core.example.com

# ── Convex/Auth ───────────────────────────────────────────────────────────────
# Set CONVEX_URL before first run for remote/CLI pairing registration. POST
# /setup also stores the Convex URL and JWKS URL in the DB after pairing.
# CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud

# ── Logging ───────────────────────────────────────────────────────────────────
# RUST_LOG=amberite_core=debug
