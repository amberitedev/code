# Amberite Core — environment variables
# Copy this file to .env and fill in the values.

# ── Dev mode ─────────────────────────────────────────────────────────────────
# Bypass JWT auth entirely. All endpoints become accessible without an
# Authorization header; AuthUser returns synthetic Claims { sub: "dev-owner" }.
#
# Defaults to true for debug builds (cargo run), false for release builds.
# Only set this explicitly if you need to override the default.
# NEVER set to true in production.
#
# AMBERITE_DEV=true

# ── Storage ───────────────────────────────────────────────────────────────────
# Root directory for all instance data (default: ~/.amberite).
# AMBERITE_DATA_DIR=~/.amberite

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Port the Core API listens on (default: 16662).
# PORT=16662

# Allowed CORS origin (default: https://amberite.dev).
# ALLOWED_ORIGIN=https://amberite.dev

# ── Supabase (populated automatically after first-run pairing) ────────────────
# You do NOT need to set these manually — POST /setup writes them to the DB.
# SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# ── Logging ───────────────────────────────────────────────────────────────────
# RUST_LOG=amberite_core=debug
