# Amberite Core — required environment variables
# Copy this file to .env.local for debug builds or .env.prod for release builds.

# ── Storage ───────────────────────────────────────────────────────────────────
# Root directory for all instance data.
CORE_DATA_DIR=

# Max .mrpack sync archives retained per sync profile.
AMBERITE_SYNC_RETAIN_COUNT=

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Port the Core API listens on.
PORT=

# Host/IP the Core API binds to. Set to 0.0.0.0 only when exposing Core to LAN or the public internet.
AMBERITE_BIND_HOST=

# Allowed CORS origin.
ALLOWED_ORIGIN=

# Public URL clients use to reach this Core when registering a pairing code with Convex.
AMBERITE_PUBLIC_URL=

# ── Convex/Auth ───────────────────────────────────────────────────────────────
# Convex deployment URL used for pairing registration.
CONVEX_URL=
CONVEX_SITE_URL=
