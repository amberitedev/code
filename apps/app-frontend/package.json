{
	"name": "@modrinth/app-frontend",
	"version": "1.0.0-local",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vue-tsc --noEmit && vp build",
		"typecheck": "vue-tsc -p tsconfig.app.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
		"tsc:check": "vue-tsc --noEmit",
		"intl:extract": "formatjs extract \"src/**/*.{vue,ts,tsx,js,jsx,mts,cts,mjs,cjs}\" --ignore \"**/*.d.ts\" --ignore node_modules --out-file src/locales/en-US/index.json --format crowdin --preserve-whitespace",
		"intl:prune-local": "pnpm -w scripts i18n-icu-contract prune-local --scope apps/app-frontend",
		"test": "vue-tsc --noEmit"
	},
	"dependencies": {
		"@amberite/contracts": "workspace:*",
		"@dnd-kit/dom": "^0.5.3",
		"@dnd-kit/vue": "^0.5.3",
		"@modrinth/api-client": "workspace:^",
		"@modrinth/assets": "workspace:*",
		"@modrinth/ui": "workspace:*",
		"@modrinth/utils": "workspace:*",
		"@sfirew/minecraft-motd-parser": "^1.1.6",
		"@tanstack/vue-query": "5.108.4",
		"@tauri-apps/api": "~2.11.1",
		"@tauri-apps/plugin-http": "~2.5.7",
		"@tauri-apps/plugin-window-state": "~2.4.1",
		"@types/three": "^0.187.0",
		"@vueuse/core": "^11.1.0",
		"ace-builds": "^1.45.2",
		"dayjs": "^1.11.23",
		"fuse.js": "^7.5.0",
		"motion-v": "2.13.0",
		"overlayscrollbars": "^2.17.1",
		"three": "^0.187.0",
		"vite-svg-loader": "^5.1.3",
		"vue": "^3.5.46",
		"vue-i18n": "^11.4.24",
		"vue-router": "^5.5.3",
		"vue3-ace-editor": "^2.2.4",
		"vuedraggable": "^4.1.0"
	},
	"devDependencies": {
		"@formatjs/cli": "^6.23.1",
		"@modrinth/tooling-config": "workspace:*",
		"@taijased/vue-render-tracker": "^1.0.7",
		"@vitejs/plugin-vue": "^6.0.11",
		"autoprefixer": "^10.7.0",
		"postcss": "^8.5.33",
		"prettier": "^3.10.1",
		"sass": "^1.108.2",
		"tailwindcss": "^3.4.4",
		"typescript": "^5.5.4",
		"vite": "^8.0.0",
		"vue-component-type-helpers": "^3.3.14",
		"vue-tsc": "^2.2.12"
	},
	"web-types": "../../web-types.json"
}
