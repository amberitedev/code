{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "amberite-realtime",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-22",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [{ "name": "PRESENCE_HUB", "class_name": "PresenceHub" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["PresenceHub"] }],
	"observability": { "enabled": true, "head_sampling_rate": 1 },
	"vars": {
		"ENVIRONMENT": "development"
	},
	"env": {
		"development": {
			"name": "amberite-realtime-development",
			"vars": { "ENVIRONMENT": "development" },
			"durable_objects": { "bindings": [{ "name": "PRESENCE_HUB", "class_name": "PresenceHub" }] }
		},
		"production": {
			"name": "amberite-realtime-production",
			"vars": { "ENVIRONMENT": "production" },
			"durable_objects": { "bindings": [{ "name": "PRESENCE_HUB", "class_name": "PresenceHub" }] }
		}
	}
}
