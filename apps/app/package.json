{
	"name": "@modrinth/app",
	"scripts": {
		"tauri": "tauri",
		"build": "tauri build",
		"dev": "tauri dev --features export-app-events,browser-bridge",
		"lint": "cargo clippy --all-targets --features updater",
		"lint:ancillary": "prettier --check .",
		"test": "cargo nextest run --all-targets --no-fail-fast --locked --features updater",
		"fix": "cargo clippy --all-targets --features updater --fix --allow-dirty",
		"fix:ancillary": "prettier --write ."
	},
	"dependencies": {
		"@modrinth/app-frontend": "workspace:*"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.5.0"
	}
}
