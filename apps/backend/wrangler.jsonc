{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "amberite-backend-local",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-14",
	"workers_dev": false,
	"preview_urls": false,
	// Served without running the Worker, so they cost no requests. `core/keys.json` is the public
	// half of the ticket keys; see README.md.
	"assets": { "directory": "./public" },
	"durable_objects": {
		"bindings": [
			{ "name": "FRIENDS", "class_name": "FriendsHub" },
			{ "name": "CORE_SIGN_IN", "class_name": "CoreSignIn" },
		],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["FriendsHub"] },
		{ "tag": "v2", "new_sqlite_classes": ["CoreSignIn"] },
	],
	"compatibility_flags": ["nodejs_compat"],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "shared-files" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "accounts",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "migrations",
		},
	],
}
